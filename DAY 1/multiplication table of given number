#include <stdio.h>

int main() {
    int n, i;

    // Prompt user for an integer
    printf("Enter an integer: ");
    scanf("%d", &n);

    printf("Multiplication table of %d:\n", n);

    // Loop from 1 to 10
    for (i = 1; i <= 10; ++i) {
        printf("%d * %d = %d\n", n, i, n * i);
    }

    return 0;
}
